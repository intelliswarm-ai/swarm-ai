<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.intelliswarm</groupId>
        <artifactId>swarmai-parent</artifactId>
        <version>1.0.29-SNAPSHOT</version>
    </parent>

    <artifactId>swarmai-bom</artifactId>
    <packaging>pom</packaging>

    <name>SwarmAI BOM</name>
    <description>Bill of Materials for SwarmAI Framework — import this POM to align all module versions</description>
    <url>https://github.com/intelliswarm-ai/swarm-ai</url>

    <scm>
        <url>https://github.com/intelliswarm-ai/swarm-ai</url>
        <connection>scm:git:git://github.com/intelliswarm-ai/swarm-ai.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/intelliswarm-ai/swarm-ai.git</developerConnection>
    </scm>

    <!--
      flatten-maven-plugin resolves ${project.version} (and the parent
      reference) into a static .flattened-pom.xml at the process-resources
      phase — BEFORE maven-gpg-plugin signs at the verify phase. Without this
      the deployed pom differs from the signed pom (the property is resolved
      on deploy), which Maven Central rejects as "Invalid signature for
      swarmai-bom-*.pom.asc". flattenMode=bom keeps <dependencyManagement>
      intact while stripping build/profiles/etc.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-studio</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-dsl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-eval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-self-improving</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-distributed</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-enterprise</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-native-anthropic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.intelliswarm</groupId>
                <artifactId>swarmai-native-ollama</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
